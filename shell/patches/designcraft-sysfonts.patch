+/// A face of a system font the host listed for the wasm build ([`set_system_fonts`]):
+/// the family and style its `name` table declares, and the file to read it from. The
+/// wasm build has no font folder to scan: the plugin shell reads the bytes through the
+/// host and adds them with [`FontDb::add_font`]; until then the family is listed in the
+/// menus and resolves to the fallback face.
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Debug)]
+pub struct SystemFont {
+    pub family: String,
+    pub style: String,
+    pub path: String,
+}
+
+/// The system fonts the host's font bridge listed (wasm only).
+#[cfg(target_arch = "wasm32")]
+static SYSTEM_FONTS: std::sync::RwLock<Vec<SystemFont>> = std::sync::RwLock::new(Vec::new());
+
+/// The families asked for but not loaded yet (wasm only): the shell reads their files
+/// through the host and adds the faces, after which the lookup finds them.
+#[cfg(target_arch = "wasm32")]
+static PENDING_FONTS: std::sync::Mutex<Vec<String>> = std::sync::Mutex::new(Vec::new());
+
+/// List the system fonts `fonts` gives (wasm only, where there is no font folder to
+/// scan). Set by the plugin shell once the host answers its font bridge.
+#[cfg(target_arch = "wasm32")]
+pub fn set_system_fonts(fonts: Vec<SystemFont>) {
+    *SYSTEM_FONTS.write().unwrap_or_else(|e| e.into_inner()) = fonts;
+}
+
+/// The system font families asked for since the last call, not loaded yet (wasm only):
+/// the shell reads their files through the host and adds the faces. Empty without a host
+/// font bridge (a plain browser build).
+#[cfg(target_arch = "wasm32")]
+pub fn take_pending_fonts() -> Vec<String> {
+    std::mem::take(&mut *PENDING_FONTS.lock().unwrap_or_else(|e| e.into_inner()))
+}
+
+/// The families asked for since the last call but not loaded yet (wasm only): remember
+/// `family` so the shell reads its file through the host and adds its faces.
+#[cfg(target_arch = "wasm32")]
+pub(super) fn remember_pending_font(family: &str) {
+    let mut pending = PENDING_FONTS.lock().unwrap_or_else(|e| e.into_inner());
+    if !pending.iter().any(|p| p.eq_ignore_ascii_case(family)) {
+        pending.push(family.to_string());
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(super) fn system_fonts() -> std::sync::RwLockReadGuard<'static, Vec<SystemFont>> {
+    SYSTEM_FONTS.read().unwrap_or_else(|e| e.into_inner())
+}
