 use std::sync::Arc;
 
 use egui::{Color32, CornerRadius, FontData, FontDefinitions, FontFamily, FontId, Stroke, TextStyle, Visuals};
+
+/// 由宿主 shell 注入的额外 fallback 字体（键, 字体字节）。wasm 里读不到系统字体，
+/// 上游 craft-fonts 在我们的构建里又为空，故中文/日文/阿拉伯文需要 shell 侧补字体。
+static EXTRA_FALLBACK_FONTS: std::sync::OnceLock<Vec<(String, Arc<FontData>)>> = std::sync::OnceLock::new();
+
+/// 宿主 shell 在启动前调用一次，注入内嵌的 CJK / 阿拉伯 fallback 字体。
+pub fn set_extra_fallback_fonts(fonts: Vec<(String, Arc<FontData>)>) {
+    let _ = EXTRA_FALLBACK_FONTS.set(fonts);
+}
+
+fn extra_fallback_fonts() -> &'static [(String, Arc<FontData>)] {
+    EXTRA_FALLBACK_FONTS.get().map(|v| &v[..]).unwrap_or(&[])
+}
